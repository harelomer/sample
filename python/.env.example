# AI-Powered Property Management Communication System
# Environment Variables Configuration

# ===================
# Application Settings
# ===================
DEBUG=false
APP_NAME="Property Management AI System"

# ===================
# Database
# ===================
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./property_management.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/property_management

# ===================
# OpenAI API
# ===================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# ===================
# WhatsApp - Green API
# ===================
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token
GREEN_API_HOST=https://api.green-api.com

# ===================
# Airbnb API (optional)
# ===================
AIRBNB_API_KEY=
AIRBNB_API_SECRET=
AIRBNB_WEBHOOK_SECRET=

# ===================
# Scheduling
# ===================
# Hour for batch job delivery (24-hour format)
BATCH_DELIVERY_HOUR=18
BATCH_DELIVERY_MINUTE=0

# Response timeouts
DEFAULT_RESPONSE_TIMEOUT_HOURS=24
URGENT_RESPONSE_TIMEOUT_HOURS=2
REMINDER_INTERVAL_HOURS=2

# ===================
# Job Assignment
# ===================
MAX_ASSIGNMENT_ATTEMPTS=5
